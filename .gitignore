# ── Config (contains callsign, passwords, never commit) ────────
config.yaml

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
*.egg-info/
dist/
build/

# ── Runtime data (stored outside repo on the Pi) ──────────────
*.log
*.json
# Vendored MapLibre basemap style JSON is static, not runtime-generated, so it's carved out here.
!web/static/maplibre/style-*.json

# ── Downloaded third-party binary (go-pmtiles, see services/tiles.py) and the extracts it produces ──
bin/
map_data/

# ── Basemap fonts/sprites (protomaps/basemaps-assets, fetched by install.sh) ──
web/static/maplibre-assets/

# ── Direwolf generated config ─────────────────────────────────
direwolf.conf

# ── SQLite database (services/db.py); -wal/-shm are WAL-mode sidecar files ──
digipeater.db
digipeater.db-wal
digipeater.db-shm

# ── Radio programming test artifacts (personal hardware captures, not project data) ──
radio_dump.bin
chirp_reference_image.bin
*.img

# ── Direwolf source build (install.sh builds Direwolf from source, see .direwolf_version) ──
direwolf-src/
.direwolf_version

# ── Legacy ────────────────────────────────────────────────────
digipeater_legacy-main/

# ── IDE / OS ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
